<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFF3F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doce Encanto"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#AD1457"
        android:gravity="center"
        android:layout_marginBottom="20dp" />
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/logo_doce_encanto"
        android:contentDescription="Logomarca Doce Encanto" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bem-vindo à nossa loja de cupcakes!"
        android:textSize="20sp"
        android:textColor="#5D4037"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/button_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Catálogo"
        android:textAllCaps="false"
        android:backgroundTint="#AD1457"
        android:textColor="#FFFFFF" />

</LinearLayout>