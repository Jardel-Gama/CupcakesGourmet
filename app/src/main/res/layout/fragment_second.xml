<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff0f5"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Nosso Cardápio – Doce Encanto"
            android:textColor="#AD1457"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/trio_cupcakes"
            android:scaleType="fitCenter"
            android:contentDescription="Cupcakes de chocolate, morango e baunilha"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cupcake de Chocolate"
            android:textColor="#5D4037"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="R$ 8,00"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnChocolate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#AD1457"
            android:text="Adicionar Chocolate"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cupcake de Morango"
            android:textColor="#5D4037"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="R$ 9,00"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnMorango"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#AD1457"
            android:text="Adicionar Morango"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cupcake de Baunilha"
            android:textColor="#5D4037"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="R$ 7,00"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnBaunilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#AD1457"
            android:text="Adicionar Baunilha"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCarrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Carrinho: 0 cupcakes"
            android:textColor="#AD1457"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total: R$ 0,00"
            android:textColor="#5D4037"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFinalizarPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#AD1457"
            android:text="Finalizar Pedido"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>